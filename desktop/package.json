{
  "name": "spice-erp-desktop",
  "version": "0.1.0",
  "description": "Offline-first desktop ERP — spice & herb retail purchasing, stock and supplier debt",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --noEmit",
    "rebuild:native": "node scripts/rebuild-native.js",
    "rebuild:native:mac": "node scripts/rebuild-native.js darwin",
    "rebuild:native:win": "node scripts/rebuild-native.js win32 x64",
    "verify:native:mac": "node scripts/verify-native-binary.js darwin",
    "verify:native:win": "node scripts/verify-native-binary.js win32",
    "restore:native": "npm --prefix .. run rebuild:dev",
    "dist:mac": "npm run build && npm run rebuild:native:mac && npm run verify:native:mac && electron-builder --mac && npm run restore:native",
    "dist:win": "npm run build && npm run rebuild:native:win && npm run verify:native:win && electron-builder --win && npm run restore:native",
    "dist": "npm run dist:mac && npm run dist:win"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.spiceerp.desktop",
    "productName": "Spice ERP",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      { "from": "../src", "to": "backend", "filter": ["**/*", "!data"] },
      { "from": "../node_modules", "to": "backend/node_modules" },
      { "from": "../package.json", "to": "backend/package.json" }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
