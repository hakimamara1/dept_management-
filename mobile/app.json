{
  "expo": {
    "name": "Spice ERP",
    "slug": "spice-erp-mobile",
    "version": "1.0.0",
    "scheme": "spiceerp",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "updates": {
      "enabled": false
    },
    "android": {
      "package": "com.spiceerp.mobile",
      "supportsRtl": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#0f7a73"
      },
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "التطبيق يحتاج الكاميرا لمسح رمز الاقتران وتصوير فواتير الموردين."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "للاختيار من صور الفواتير المحفوظة في المعرض."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f7a73"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f7a73"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withGradleMemory"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8798b02-f8ac-412f-bb52-d0cc9e438558"
      }
    }
  }
}
